# Database Configuration
DATABASE_URL=postgresql://apex_user:apex_password@database:5432/apex_flow_db
POSTGRES_DB=apex_flow_db
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=apex_password
DB_PORT=5432

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-here-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application Configuration
NODE_ENV=development
FRONTEND_PORT=3444
BACKEND_PORT=8000

# Docker User Configuration (for file permissions)
# Update these to match your system user ID
UID=1000
GID=1000
UNAME=devuser
GNAME=devuser

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3444